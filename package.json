{
  "name": "invest-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:clean": "rm -rf .next && next dev --hostname 0.0.0.0 --port 3000",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:production:setup": "node scripts/apply-turso-schema.mjs && npm run db:seed",
    "db:turso:schema": "node scripts/apply-turso-schema.mjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "^15.1.12",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.1.12",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
